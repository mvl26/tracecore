+def _is_interactive_login(request):
+	return (
+		request is not None
+		and request.method == "POST"
+		and request.path in ("/", "/login")
+		and request.mimetype == "application/x-www-form-urlencoded"
+		and frappe.form_dict.get("cmd") == "login"

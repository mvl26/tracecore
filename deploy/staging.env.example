# Cấu hình staging TraceCore (bench tracecore-staging trên máy chủ dev Miyano, ADR-011 §7.2).
# Chép thành staging.env (quyền 600), KHÔNG commit file thật. Dùng với:
#   scripts/install_prod.sh --env staging.env [--dry-run]
SITE_NAME=tracecore-staging
TRACECORE_REF=v0.1.0
FRAPPE_USER=frappe
BENCH_DIR=/home/frappe/tracecore-staging
DB_ROOT_PASSWORD=<đặt-trong-file-thật>
ADMIN_PASSWORD=<đặt-trong-file-thật>
# Tiền tố GS1 test (952 = dải demo của GS1) cho tới khi có prefix thật của bệnh viện (OQ-05, P-13)
TC_GS1_COMPANY_PREFIX=9520000
BACKUP_DIR=/backup/tracecore-staging
# Sao lưu ngoài site (restic) — cấu hình ở initial-deployment
RESTIC_REPOSITORY=<sftp:backup@host:/tracecore-staging>
RESTIC_PASSWORD_FILE=/etc/tracecore/restic.pass
